{
  "version": "1.0.0",
  "updated": "2026-09-27",
  "title": "数据中心 TCO 因子树",
  "note": "经济模型的骨架：收入侧与成本侧的最小可变因子。每个因子指向它汇总的爆炸图部件（framework/bom.json，2026-09-28 起为 2.0）与站点权利（framework/site_rights.json，site_rights 字段）、读取的价格库序列（data/prices.json）、对应的研究问题（framework/research_questions.json）、进入经济模型的输入键（data/datacenter_economics_model.json）以及定向抓取目标。因子树只定义结构与归属，不保存数值；数值在价格库与模型假设里。fetch.kind 取 product / news / data / report。",
  "formulas": {
    "revenue": "收入 = GPU 数 × 8,760 × 付费利用率 × 单价；GPU 数 = IT 容量 × 每 MW 密度；密度 = 1,000 kW × 加速器机柜占 IT 功率份额 ÷ (机柜功率 ÷ 每柜 GPU 数)",
    "cost": "年度成本 = 电费 + 其他运营 + 设施费 + 折旧 + 税；电费 = IT 容量 × 负载率 × PUE × 8,760 × 电价；折旧 = 资本开支 ÷ 寿命（IT 与非 IT 分线）；设施费按自建 / 租壳 / 托管三选一"
  },
  "factors": [
    {
      "id": "revenue",
      "label": "收入侧",
      "side": "revenue",
      "parent": null,
      "unit": "$/年",
      "formula": "gpus × 8760 × utilization × price"
    },
    {
      "id": "revenue.gpus",
      "label": "GPU 数",
      "side": "revenue",
      "parent": "revenue",
      "unit": "颗",
      "formula": "it_mw × density",
      "model_inputs": [
        "it_mw",
        "gpus_per_mw"
      ]
    },
    {
      "id": "revenue.gpus.density",
      "label": "每 MW GPU 密度",
      "side": "revenue",
      "parent": "revenue.gpus",
      "unit": "颗/MW",
      "formula": "1000 × rack_share ÷ (rack_kw ÷ gpus_per_rack)",
      "bom_parts": [
        "rack-frame",
        "rack-system",
        "gpu",
        "power-shelf"
      ],
      "questions": [
        "M06-Q01",
        "M06-Q02"
      ],
      "model_inputs": [
        "gpus_per_mw",
        "generation"
      ],
      "fetch": [
        {
          "kind": "product",
          "what": "厂商机柜规格：整柜功率（TDP/额定）、每柜 GPU 封装数、代际发布与出货时间",
          "sources": [
            "NVIDIA 参考架构与产品页",
            "AWS/Google 自研芯片文档",
            "ODM 数据手册"
          ],
          "cadence": "每代际发布时"
        }
      ]
    },
    {
      "id": "revenue.utilization",
      "label": "付费利用率",
      "side": "revenue",
      "parent": "revenue",
      "unit": "%",
      "questions": [
        "M13-Q01"
      ],
      "model_inputs": [
        "utilization",
        "monetized_share"
      ],
      "fetch": [
        {
          "kind": "report",
          "what": "集群实际利用率的公开研究与公司披露（已售 GPU 小时 ÷ 可用小时）",
          "sources": [
            "SemiAnalysis",
            "公司财报电话会",
