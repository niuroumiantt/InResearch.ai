  "delivery_contract": {
    "version": "1.0",
    "required": [
      "provider_id",
      "delivery_id",
      "task_id_or_discovery",
      "collector_revision",
      "items"
    ],
    "item_required": [
      "source_item_id",
      "source",
      "retrieved_at",
      "sha256",
      "content_type",
      "completeness",
      "access_scope",
      "version_relation"
    ],
    "receipt_states": [
      "received",
      "needs_supplement",
      "accepted",
      "rejected"
    ],
    "research_adoption_separate": true
  }
