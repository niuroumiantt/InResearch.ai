      "kind": "proposed",
      "repository": null,
      "mapping": "P/V/D · T03/T05/T09",
      "acceptance": "地域、单位、统计期、方法与数据修订",
      "connection": "not_connected"
    },
    {
      "id": "literature",
      "name": "文献采集",
