    "nvidia_nas_unavailable": {
      "source_and_permanent_storage": "m5_local_for_validation; spark_deferred",
      "analysis_worker": "m5",
      "reading_client": "claude_code_cli",
      "ocr": "local_vision_model_separate_from_reading_model",
      "worker_data": "content-addressed temporary copies and candidate outputs only",
      "publish_credential_host": "m5",
      "publish_route": "M5 local original + Claude candidate/status -> HTTPS AWS candidate/progress receiver",
