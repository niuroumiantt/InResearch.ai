{
  "version": "1.0.0",
  "updated": "2026-09-28",
  "title": "五层目标清单",
  "note": "六队采集分队的唯一任务来源：每一行是一个采集目标，写明它属于五层中的哪一层、汇到因子树的哪个因子、喂模型的哪些输入、进价格库的哪些序列（已有或计划）、来自什么披露类型与出版方类别、当前实例、抓取机制、主责队、主执行机、发布日历与下次到期。公司只是实例，随时可换；数字进观测数据、规格进参照数据、文本进材料档案再提取。",
  "principles": [
    "需求只来自本清单，各队不自定抓什么",
    "一个来源只属一个队、一台主执行机；换主机等于结束旧任务开新任务",
    "交付只走供应中心一个入口，按 fetchspec 包格式",
    "给 inresearch 的采集默认不翻译；挑选在先，翻译在后"
  ],
  "layers": {
    "1": "构成",
    "2": "运行",
    "3": "价格",
    "4": "时间",
    "5": "主体"
  },
  "data_classes": {
    "reference": "参照数据，按版本改",
    "observation": "观测数据，按时点追加（series_id + as_of）",
    "material": "材料档案，交由 Spark 提取后再入事实"
  },
  "mechanisms": {
    "api": "公开 API 或固定表格下载",
    "table": "固定网页表格",
