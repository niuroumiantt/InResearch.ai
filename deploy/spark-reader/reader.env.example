# Copy to ~/.config/inresearch.ai/reader.env (0600). Do not commit the live file.
# Explicit loopback Ollama backend; this worker never switches to a fake model.
READER_BACKEND=ollama
READER_URL=http://127.0.0.1:11434
READER_MODEL=qwen3.8:27b
READER_TIMEOUT=900
# Worker threads inside the one queue-owning process (1..16, default 1). More than
# one only helps if the Ollama server itself answers requests in parallel; set
# OLLAMA_NUM_PARALLEL on the server to at least this value, and keep the product of
# parallel requests and num_ctx inside GPU memory or Ollama will swap the model.
# READER_WORKERS=1
READER_STABLE_SECONDS=60
# Optional, explicit installed vision model. Without it, scanned/image-heavy
# pages are blocked. Enabling OCR later and retrying preserves earlier work.
# READER_OCR_MODEL=qwen3-vl:8b
# OCR budget and ordering (defaults shown). Scanned documents wait behind text-layer
# documents; per-document OCR page cap; A2-and-larger raster pages are drawings, not OCR.
# READER_OCR_MAX_PAGES=20
# READER_OCR_DEFER_SECONDS=300
# READER_LARGE_FORMAT_POINTS=1150
# Alternative gateway (brain route must report the actual qwen3.8:27b model):
# READER_BACKEND=gateway
# READER_URL=http://127.0.0.1:8080
# DGX_API_KEY=<configure locally; never print or commit the value>
