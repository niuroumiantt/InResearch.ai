[Unit]
Description=Refresh the research website from the Spark ledger every five minutes

[Timer]
OnBootSec=90
# 2026-09-29：OnUnitInactiveSec 在服务结束（成功或失败）5 分钟后重排；此前的 OnUnitActiveSec 在一次失败后不再触发。
OnUnitInactiveSec=5min
AccuracySec=15
Unit=inresearch-reader-publish.service

[Install]
WantedBy=timers.target
