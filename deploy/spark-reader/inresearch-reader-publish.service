[Unit]
Description=Publish inresearch candidate research and reader status
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/inresearch.ai
EnvironmentFile=-%h/.config/inresearch.ai/reader.env
EnvironmentFile=-%h/.config/inresearch.ai/publish.env
ExecStart=/usr/bin/python3 %h/code/inresearch.ai/pipeline/publish_reader.py
UMask=0077
Nice=15
TimeoutStartSec=180
NoNewPrivileges=yes
PrivateTmp=yes

