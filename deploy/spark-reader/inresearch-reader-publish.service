[Unit]
Description=Publish inresearch candidate research and reader status
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/inresearch.ai
EnvironmentFile=-%h/.config/inresearch.ai/reader.env
EnvironmentFile=-%h/.config/inresearch.ai/publish.env
ExecStart=/usr/bin/python3 %h/code/inresearch.ai/manage.py publish --if-changed
UMask=0077
Nice=15
TimeoutStartSec=420
# Export/preparation precedes a bounded 240 s HTTPS retry budget.
# A 2026-10-11 128 MB receipt exceeded the old 120 s network budget while
# the receiver was still constructing its verified view under CPU contention.
# Retain the former 180 s preparation allowance; resource limits remain below.
CPUQuota=200%
MemoryMax=4G
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes

