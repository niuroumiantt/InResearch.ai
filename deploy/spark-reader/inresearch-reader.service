[Unit]
Description=InResearch persistent candidate document reader
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/code/inresearch.ai
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-%h/.config/inresearch.ai/reader.env
ExecStart=/usr/bin/python3 %h/code/inresearch.ai/pipeline/continuous_reader.py run
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
KillMode=control-group
UMask=0077
Nice=10
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/inresearch.ai %h/.local/state/inresearch.ai
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
