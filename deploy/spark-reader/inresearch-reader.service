[Unit]
Description=InResearch persistent candidate document reader
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/code/inresearch.ai
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-%h/.config/inresearch.ai/reader.env
ExecStart=/usr/bin/python3 %h/code/inresearch.ai/manage.py reader run
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
KillMode=control-group
UMask=0077
Nice=10
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
# Hard ceilings, not just relative weights. CPUWeight only decides who yields
# when the machine is contended; it cannot stop this service from occupying the
# machine on its own. On 2026-09-09 the Spark ran READER_WORKERS=4 unattended and
# was found nine days later still at full load and 92 C, with nothing able to
# stop it. These bound the blast radius of any future runaway.
CPUQuota=400%
MemoryHigh=4G
MemoryMax=8G
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/inresearch.ai %h/.local/state/inresearch.ai
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
