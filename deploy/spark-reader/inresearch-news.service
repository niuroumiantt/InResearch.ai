[Unit]
Description=Sync datacenter-only inews headlines to Spark
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/inresearch.ai
EnvironmentFile=-%h/.config/inresearch.ai/reader.env
ExecStart=/usr/bin/python3 %h/code/inresearch.ai/manage.py news-sync
UMask=0077
Nice=15
TimeoutStartSec=1800
NoNewPrivileges=yes
PrivateTmp=yes
