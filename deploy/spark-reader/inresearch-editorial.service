[Unit]
Description=InResearch published column intake
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/inresearch.ai
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=INRESEARCH_PROJECT_ROOT=%h/code/inresearch.ai
EnvironmentFile=-%h/.config/inresearch.ai/reader.env
ExecStart=/usr/bin/python3 %h/code/inresearch.ai/manage.py editorial-sync --receipt %h/.local/state/inresearch.ai/editorial-sync/latest.json
TimeoutStartSec=1800
UMask=0077
Nice=15
NoNewPrivileges=true
PrivateTmp=true
