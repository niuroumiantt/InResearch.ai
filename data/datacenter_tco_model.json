    "cost_per_fte": 130000,
    "maint_pct_facility": 0.02,
    "maint_pct_it": 0.03,
    "software_per_mw": 0.05,
    "insurance_pct": 0.004,
    "bandwidth_per_mw": 0.08,
    "other_opex_per_mw": 0.1,
    "opex_escalation": 0.025,
    "decommission_pct": 0.02,
    "wacc": 0.08,
    "business_model": "gpu_rental",
    "price_gpu_hour": 8.5,
    "price_colo_kw_month": 180
  },
  "groups": [
    {
      "id": "project",
      "label": "1 · 项目定义",
      "hint": "规模、冗余等级与时间轴",
      "inputs": [
        "it_mw",
        "redundancy",
        "construction_years",
        "horizon_years",
        "ramp_year1",
        "ramp_year2"
      ]
    },
    {
      "id": "site",
      "label": "2 · 站点",
      "hint": "电价、土地、人力与税费由所在地决定",
      "inputs": [
        "site",
        "power_price",
        "demand_rate",
        "power_escalation",
        "land_per_mw",
        "labor_index",
        "property_tax_rate",
        "water_price"
      ]
    },
    {
      "id": "design",
      "label": "3 · 设计",
      "hint": "冷却方式决定 PUE、WUE 与机械造价",
      "inputs": [
        "cooling",
        "pue",
        "wue"
      ]
    },
    {
      "id": "it",
      "label": "4 · IT 设备",
      "hint": "设备类型决定单位造价、负载与更新周期",
      "inputs": [
        "it_class",
        "it_capex_per_kw",
        "load_factor",
        "it_refresh_years",
        "refresh_cost_factor",
        "gpus_per_mw",
        "gpu_utilization"
      ]
    },
    {
      "id": "build",
      "label": "5 · 建设",
      "hint": "设施资本开支按系统分项，或改为租壳/托管",
      "inputs": [
        "facility_mode",
        "capex_building",
        "capex_electrical",
        "capex_mechanical",
        "capex_fitout",
        "soft_cost_pct",
        "contingency_pct",
        "shell_rent_per_mw",
        "colo_rate"
      ]
    },
    {
      "id": "operate",
      "label": "6 · 运营",
      "hint": "人员、维护、软件、保险、带宽",
      "inputs": [
        "fte_per_mw",
        "cost_per_fte",
        "maint_pct_facility",
        "maint_pct_it",
        "software_per_mw",
        "insurance_pct",
        "bandwidth_per_mw",
        "other_opex_per_mw",
        "opex_escalation",
        "decommission_pct"
