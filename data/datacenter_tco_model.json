  "currency": "USD",
  "status": "illustrative_research_model",
  "summary": "通用数据中心全生命周期 TCO 模型：项目定义 → 站点 → 设计 → IT → 建设 → 运营 → 财务，逐年现金流，折现后按每 MW·年、每 kW·月、每 IT kWh、每 GPU 小时给出平准化成本。参数为研究假设，站点与设计预设只作起点。",
  "assumptions": {
    "it_mw": 100,
    "redundancy": "n_plus_1",
    "construction_years": 2,
    "horizon_years": 15,
    "ramp_year1": 0.6,
    "ramp_year2": 0.9,
    "site": "us_virginia",
    "power_price": 0.1,
    "demand_rate": 12,
    "power_escalation": 0.02,
    "land_per_mw": 0.5,
    "labor_index": 1.0,
    "property_tax_rate": 0.008,
    "water_price": 2.0,
    "cooling": "liquid",
    "pue": 1.18,
    "wue": 0.3,
    "it_class": "gb300",
    "it_capex_per_kw": 23000,
    "load_factor": 0.7,
    "it_refresh_years": 5,
    "refresh_cost_factor": 0.85,
    "gpus_per_mw": 410,
