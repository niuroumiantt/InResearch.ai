{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "政策库记录（主键 = policy_id）",
  "type": "object",
  "required": ["policy_id", "jurisdiction", "name", "type", "status", "verified_date", "source_url"],
  "properties": {
    "policy_id": {"type": "string", "description": "辖区-短名，如 us-export-control-2025 / cn-east-west-compute"},
    "jurisdiction": {"type": "string", "description": "US / CN / EU / us-va / cn-gd 等"},
    "name": {"type": "string"},
    "type": {"type": "string", "enum": ["tax-incentive", "export-control", "energy-permit", "zoning", "subsidy", "tariff", "grid-rule", "other"]},
    "status": {"type": "string", "enum": ["proposed", "active", "amended", "expired", "repealed"]},
    "summary": {"type": "string"},
    "impact_modules": {"type": "array", "items": {"type": "string"}},
    "effective_date": {"type": ["string", "null"]},
    "verified_date": {"type": "string"},
    "source_url": {"type": "string"}
  }
}
