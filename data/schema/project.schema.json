{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "项目库记录（主键 = 物理地点 site_id）",
  "type": "object",
  "required": [
    "site_id",
    "name",
    "region",
    "country",
    "status",
    "verified_date",
    "sources"
  ],
  "properties": {
    "observations": {
      "type": "array",
      "description": "同一物理站点的追加观测；顶层旧字段为基线，当前视图按有效时间选择",
      "items": {
        "type": "object",
        "required": [
          "id",
          "effective_at",
          "recorded_at",
          "kind",
          "scope",
          "basis",
          "fields",
          "adoption"
        ],
        "properties": {
          "effective_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "保留年、月、日或未知精度，不补造日期"
          },
          "kind": {
            "enum": [
              "disclosed",
              "reported",
              "estimated",
              "derived",
              "forecast"
            ]
          },
          "scope": {
            "anyOf": [
              {
                "const": "whole_site"
              },
              {
                "type": "string",
                "pattern": "^phase:[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
              }
            ]
          },
          "fields": {
            "type": "object",
            "properties": {
              "capacity_it_mw": {
                "$ref": "#/$defs/site_power_quantity"
              },
              "capacity_facility_mw": {
                "$ref": "#/$defs/site_power_quantity"
              },
              "capacity_it_mw_by_status": {
                "type": "object",
                "patternProperties": {
                  "^L[1-9]$": {
                    "$ref": "#/$defs/site_power_quantity"
                  }
                },
                "additionalProperties": false
              }
            },
            "description": "容量总数/分期/估算性质作为完整字段束；原生区间无隐含中点，runtime校验顺序/依据和跨记录修订"
          },
          "adoption": {
            "type": "object"
          },
          "schema_version": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "recorded_at": {
            "type": "string",
            "description": "首次正式写入时间；v2带时区，重放保持"
          },
          "reviewed_at": {
            "type": "string",
            "description": "实际具名审核时间；不代替观测、披露或接收时间"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "description": "有效期末保留原始精度，届满不复活旧值"
          },
          "source_versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_sha256",
                "published_at",
                "first_received_at",
                "published_at_provenance",
                "first_received_at_provenance",
                "published_at_precision",
                "first_received_at_precision"
              ],
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "该SHA来源版本的披露/更新时间；原文定位复核，未知null"
                },
                "first_received_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "实际台账最早有记录的接收时间，带时区；历史未知null，不能自报"
                },
                "published_at_provenance": {
                  "type": "string",
                  "minLength": 1
                },
                "first_received_at_provenance": {
                  "type": "string",
                  "minLength": 1
                },
                "published_at_precision": {
                  "enum": [
                    "unknown",
                    "year",
                    "month",
                    "day",
                    "timestamp"
                  ]
                },
                "first_received_at_precision": {
                  "enum": [
                    "unknown",
                    "year",
                    "month",
                    "day",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "revision": {
            "type": "object",
            "required": [
              "action",
              "observation_ids",
              "owner_decision"
            ],
            "properties": {
              "action": {
                "enum": [
                  "replace",
                  "withdraw"
                ]
              },
              "observation_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "owner_decision": {
                "type": "object",
                "description": "实际所有者对具体after SHA和旧IDs的采用决定；跨记录链由site_timeline.check_history校验"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "schema_version"
              ],
              "properties": {
                "schema_version": {
                  "const": 2
                }
              }
            },
            "then": {
              "required": [
                "reviewed_at",
                "source_versions"
              ]
            }
          }
        ]
      }
    },
    "site_id": {
      "type": "string",
      "description": "物理地点主键：国家-地区-地名小写连字符，如 us-tx-abilene"
    },
    "duplicate_of": {
      "type": "string",
      "description": "已审阅同一物理项目的主记录 site_id；目标不得再指向别名，原始证据保留但聚合不累计"
    },
    "deduplication_note": {
      "type": "string",
      "description": "去重审核日期、来源与选择依据；不改变原核验日期"
    },
    "name": {
      "type": "string",
      "description": "当前项目名（改名不改主键，旧名进 aliases）"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "region": {
      "type": "string",
      "description": "区域带，如 north-america / europe / china / apac / mena"
    },
    "country": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "州/省 + 城市"
    },
    "coordinates": {
      "type": "string",
      "description": "lat,lon 可选"
    },
    "developer": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "company_id 列表：谁建（M02）"
    },
    "tenant": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "company_id 列表：谁用（M03，经 contracts 关联）"
    },
    "status": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9"
      ],
      "description": "九级漏斗，见 framework/01_data_standards.md"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        }
      }
    },
    "capacity_it_mw": {
      "type": [
        "number",
        "null"
      ],
      "description": "IT 容量 MW（唯一可聚合的容量口径）"
    },
    "capacity_it_mw_by_status": {
      "type": "object",
      "description": "分期项目：各状态下的容量拆分 {\"L8\": 200, \"L6\": 400}"
    },
    "capacity_facility_mw": {
      "type": [
        "number",
        "null"
      ],
      "description": "设施总功率，永不与 IT 容量相加"
    },
    "power_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "电力进展摘要（M04）"
    },
    "utility": {
      "type": [
        "string",
        "null"
      ],
      "description": "所属电网/电力公司"
    },
    "type": {
      "type": "string",
      "enum": [
        "hyperscaler-selfbuild",
        "ai-lab-selfbuild",
        "colo-wholesale",
        "neocloud",
        "sovereign",
        "enterprise",
        "aidc-cn",
        "other"
      ]
    },
    "notes": {
      "type": "string"
    },
    "disputed": {
      "type": "boolean",
      "default": false
    },
    "verified_date": {
      "type": "string",
      "description": "YYYY-MM-DD 最后人工核验日期"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "grade"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "enum": [
              "regulatory",
              "company",
              "research",
              "media",
              "estimate"
            ]
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "site_power_quantity": {
      "anyOf": [
        {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        {
          "type": "object",
          "required": [
            "unit"
          ],
          "oneOf": [
            {
              "required": [
                "value"
              ],
              "not": {
                "required": [
                  "value_range"
                ]
              }
            },
            {
              "required": [
                "value_range"
              ],
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          ],
          "properties": {
            "unit": {
              "enum": [
                "MW",
                "GW"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0
            },
            "value_range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
