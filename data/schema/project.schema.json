{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "项目库记录（主键 = 物理地点 site_id）",
  "type": "object",
  "required": [
    "site_id",
    "name",
    "region",
    "country",
    "status",
    "verified_date",
    "sources"
  ],
  "properties": {
    "observations": {
      "type": "array",
      "description": "同一物理站点的追加观测；顶层旧字段为基线，当前视图按有效时间选择",
      "items": {
        "type": "object",
        "required": [
          "id",
          "effective_at",
          "recorded_at",
          "kind",
          "scope",
          "basis",
          "fields",
          "adoption"
        ],
        "properties": {
          "effective_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "保留年、月、日或未知精度，不补造日期"
          },
          "kind": {
            "enum": [
              "disclosed",
              "reported",
              "estimated",
              "derived",
              "forecast"
            ]
          },
          "scope": {
            "anyOf": [
              {
                "const": "whole_site"
              },
              {
                "type": "string",
                "pattern": "^phase:[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
              }
            ]
          },
          "fields": {
            "type": "object",
            "properties": {
              "capacity_it_mw": {
                "$ref": "#/$defs/site_power_quantity"
              },
              "capacity_facility_mw": {
                "$ref": "#/$defs/site_power_quantity"
              },
              "capacity_it_mw_by_status": {
                "type": "object",
                "patternProperties": {
                  "^L[1-9]$": {
                    "$ref": "#/$defs/site_power_quantity"
                  }
                },
                "additionalProperties": false
              },
              "land_owner": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "土地权利人；身份及有效时间需独立核验，不从其他角色推断"
              },
              "owner": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "资产所有者；身份及有效时间需独立核验，不从其他角色推断"
              },
              "developer": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "开发方；身份及有效时间需独立核验，不从其他角色推断"
              },
              "designer": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "设计方；身份及有效时间需独立核验，不从其他角色推断"
              },
              "builder": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "EPC／总包；身份及有效时间需独立核验，不从其他角色推断"
              },
              "operator": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "运营方；身份及有效时间需独立核验，不从其他角色推断"
              },
              "tenant": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "直接使用／承租方；身份及有效时间需独立核验，不从其他角色推断"
              },
              "end_user": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "最终使用者；身份及有效时间需独立核验，不从其他角色推断"
              },
              "investor": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "股权出资方；身份及有效时间需独立核验，不从其他角色推断"
              },
              "lender": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "贷款方；身份及有效时间需独立核验，不从其他角色推断"
              },
              "power_supplier": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "供电服务方；身份及有效时间需独立核验，不从其他角色推断"
              },
              "water_supplier": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "供水服务方；身份及有效时间需独立核验，不从其他角色推断"
              },
              "network_provider": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "网络服务方；身份及有效时间需独立核验，不从其他角色推断"
              },
              "capacity_planned_it_mw": {
                "$ref": "#/$defs/site_power_quantity"
              },
              "electricity_consumption_mwh": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/site_resource_quantity"
                      },
                      {
                        "properties": {
                          "unit": {
                            "enum": [
                              "kWh",
                              "MWh",
                              "GWh",
                              "TWh"
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "water_consumption_m3": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/site_resource_quantity"
                      },
                      {
                        "properties": {
                          "unit": {
                            "enum": [
                              "L",
                              "m3",
                              "m³",
                              "US gal"
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "water_withdrawal_m3": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/site_resource_quantity"
                      },
                      {
                        "properties": {
                          "unit": {
                            "enum": [
                              "L",
                              "m3",
                              "m³",
                              "US gal"
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "water_use_m3_per_day": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/site_resource_quantity"
                      },
                      {
                        "properties": {
                          "unit": {
                            "enum": [
                              "m3/day",
                              "m³/day",
                              "L/day",
                              "US gal/day"
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "pue": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/site_resource_quantity"
                      },
                      {
                        "properties": {
                          "unit": {
                            "enum": [
                              "PUE"
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "wue_l_per_kwh_it": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/site_resource_quantity"
                      },
                      {
                        "properties": {
                          "unit": {
                            "enum": [
                              "L/kWh IT",
                              "m3/MWh IT",
                              "m³/MWh IT"
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "borrower": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "借款主体；按来源独立核验，不从产权或使用关系推断"
              },
              "guarantor": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "担保方；按来源独立核验，不从产权或使用关系推断"
              },
              "lessor": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "租约出租方；按来源独立核验，不从产权或使用关系推断"
              }
            },
            "description": "容量总数/分期/估算性质作为完整字段束；原生区间无隐含中点，runtime校验顺序/依据和跨记录修订"
          },
          "adoption": {
            "type": "object"
          },
          "schema_version": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "recorded_at": {
            "type": "string",
            "description": "首次正式写入时间；v2带时区，重放保持"
          },
          "reviewed_at": {
            "type": "string",
            "description": "实际具名审核时间；不代替观测、披露或接收时间"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "description": "有效期末保留原始精度，届满不复活旧值"
          },
          "source_versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_sha256",
                "published_at",
                "first_received_at",
                "published_at_provenance",
                "first_received_at_provenance",
                "published_at_precision",
                "first_received_at_precision"
              ],
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "该SHA来源版本的披露/更新时间；原文定位复核，未知null"
                },
                "first_received_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "实际台账最早有记录的接收时间，带时区；历史未知null，不能自报"
                },
                "published_at_provenance": {
                  "type": "string",
                  "minLength": 1
                },
                "first_received_at_provenance": {
                  "type": "string",
                  "minLength": 1
                },
                "published_at_precision": {
                  "enum": [
                    "unknown",
                    "year",
                    "month",
                    "day",
                    "timestamp"
                  ]
                },
                "first_received_at_precision": {
                  "enum": [
                    "unknown",
                    "year",
                    "month",
                    "day",
                    "timestamp"
                  ]
                }
              }
            }
          },
          "revision": {
            "type": "object",
            "required": [
              "action",
              "observation_ids",
              "owner_decision"
            ],
            "properties": {
              "action": {
                "enum": [
                  "replace",
                  "withdraw"
                ]
              },
              "observation_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "owner_decision": {
                "type": "object",
                "description": "实际所有者对具体after SHA和旧IDs的采用决定；跨记录链由site_timeline.check_history校验"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "schema_version"
              ],
              "properties": {
                "schema_version": {
                  "const": 2
                }
              }
            },
            "then": {
              "required": [
                "reviewed_at",
                "source_versions"
              ]
            }
          }
        ]
      }
    },
    "site_id": {
      "type": "string",
      "description": "物理地点主键：国家-地区-地名小写连字符，如 us-tx-abilene"
    },
    "duplicate_of": {
      "type": "string",
      "description": "已审阅同一物理项目的主记录 site_id；目标不得再指向别名，原始证据保留但聚合不累计"
    },
    "deduplication_note": {
      "type": "string",
      "description": "去重审核日期、来源与选择依据；不改变原核验日期"
    },
    "name": {
      "type": "string",
      "description": "当前项目名（改名不改主键，旧名进 aliases）"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "region": {
      "type": "string",
      "description": "区域带，如 north-america / europe / china / apac / mena"
    },
    "country": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "州/省 + 城市"
    },
    "coordinates": {
      "type": "string",
      "description": "lat,lon 可选"
    },
    "developer": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "company_id 列表：谁建（M02）"
    },
    "tenant": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "company_id 列表：谁用（M03，经 contracts 关联）"
    },
    "status": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9"
      ],
      "description": "九级漏斗，见 framework/01_data_standards.md"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        }
      }
    },
    "capacity_it_mw": {
      "type": [
        "number",
        "null"
      ],
      "description": "IT 容量 MW（唯一可聚合的容量口径）"
    },
    "capacity_it_mw_by_status": {
      "type": "object",
      "description": "分期项目：各状态下的容量拆分 {\"L8\": 200, \"L6\": 400}"
    },
    "capacity_facility_mw": {
      "type": [
        "number",
        "null"
      ],
      "description": "设施总功率，永不与 IT 容量相加"
    },
    "power_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "电力进展摘要（M04）"
    },
    "utility": {
      "type": [
        "string",
        "null"
      ],
      "description": "所属电网/电力公司"
    },
    "type": {
      "type": "string",
      "enum": [
        "hyperscaler-selfbuild",
        "ai-lab-selfbuild",
        "colo-wholesale",
        "neocloud",
        "sovereign",
        "enterprise",
        "aidc-cn",
        "other"
      ]
    },
    "notes": {
      "type": "string"
    },
    "disputed": {
      "type": "boolean",
      "default": false
    },
    "verified_date": {
      "type": "string",
      "description": "YYYY-MM-DD 最后人工核验日期"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "grade"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "enum": [
              "regulatory",
              "company",
              "research",
              "media",
              "estimate"
            ]
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "land_owner": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "土地权利人；身份及有效时间需独立核验，不从其他角色推断"
    },
    "owner": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "资产所有者；身份及有效时间需独立核验，不从其他角色推断"
    },
    "designer": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "设计方；身份及有效时间需独立核验，不从其他角色推断"
    },
    "builder": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "EPC／总包；身份及有效时间需独立核验，不从其他角色推断"
    },
    "operator": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "运营方；身份及有效时间需独立核验，不从其他角色推断"
    },
    "end_user": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "最终使用者；身份及有效时间需独立核验，不从其他角色推断"
    },
    "investor": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "股权出资方；身份及有效时间需独立核验，不从其他角色推断"
    },
    "lender": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "贷款方；身份及有效时间需独立核验，不从其他角色推断"
    },
    "power_supplier": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "供电服务方；身份及有效时间需独立核验，不从其他角色推断"
    },
    "water_supplier": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "供水服务方；身份及有效时间需独立核验，不从其他角色推断"
    },
    "network_provider": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "网络服务方；身份及有效时间需独立核验，不从其他角色推断"
    },
    "province": {
      "type": [
        "string",
        "null"
      ],
      "description": "明确登记的地理分量；不从模糊地点猜值"
    },
    "city": {
      "type": [
        "string",
        "null"
      ],
      "description": "明确登记的地理分量；不从模糊地点猜值"
    },
    "district": {
      "type": [
        "string",
        "null"
      ],
      "description": "明确登记的地理分量；不从模糊地点猜值"
    },
    "street_address": {
      "type": [
        "string",
        "null"
      ],
      "description": "明确登记的地理分量；不从模糊地点猜值"
    },
    "parcel_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "identity_scope": {
      "enum": [
        "registered_site",
        "physical_campus",
        "cluster",
        "portfolio"
      ],
      "description": "仅核实明确物理边界后标physical_campus"
    },
    "capacity_planned_it_mw": {
      "$ref": "#/$defs/site_power_quantity",
      "description": "园区整体规划IT容量；不加到阶段合计，不从阶段求和推定"
    },
    "borrower": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "借款主体；按来源独立核验，不从产权或使用关系推断"
    },
    "guarantor": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "担保方；按来源独立核验，不从产权或使用关系推断"
    },
    "lessor": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "租约出租方；按来源独立核验，不从产权或使用关系推断"
    }
  },
  "$defs": {
    "site_power_quantity": {
      "anyOf": [
        {
