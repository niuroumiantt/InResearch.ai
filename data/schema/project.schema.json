{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "项目库记录（主键 = 物理地点 site_id）",
  "type": "object",
  "required": ["site_id", "name", "region", "country", "status", "verified_date", "sources"],
  "properties": {
    "site_id": {"type": "string", "description": "物理地点主键：国家-地区-地名小写连字符，如 us-tx-abilene"},
    "name": {"type": "string", "description": "当前项目名（改名不改主键，旧名进 aliases）"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "region": {"type": "string", "description": "区域带，如 north-america / europe / china / apac / mena"},
    "country": {"type": "string"},
    "location": {"type": "string", "description": "州/省 + 城市"},
    "coordinates": {"type": "string", "description": "lat,lon 可选"},
    "developer": {"type": "array", "items": {"type": "string"}, "description": "company_id 列表：谁建（M02）"},
    "tenant": {"type": "array", "items": {"type": "string"}, "description": "company_id 列表：谁用（M03，经 contracts 关联）"},
    "status": {"type": "string", "enum": ["L1", "L2", "L3", "L4", "L5", "L6", "L7", "L8", "L9"], "description": "九级漏斗，见 framework/01_data_standards.md"},
    "status_history": {"type": "array", "items": {"type": "object", "properties": {"status": {"type": "string"}, "date": {"type": "string"}, "source_url": {"type": "string"}}}},
    "capacity_it_mw": {"type": ["number", "null"], "description": "IT 容量 MW（唯一可聚合的容量口径）"},
    "capacity_it_mw_by_status": {"type": "object", "description": "分期项目：各状态下的容量拆分 {\"L8\": 200, \"L6\": 400}"},
    "capacity_facility_mw": {"type": ["number", "null"], "description": "设施总功率，永不与 IT 容量相加"},
    "power_status": {"type": ["string", "null"], "description": "电力进展摘要（M04）"},
    "utility": {"type": ["string", "null"], "description": "所属电网/电力公司"},
    "type": {"type": "string", "enum": ["hyperscaler-selfbuild", "ai-lab-selfbuild", "colo-wholesale", "neocloud", "sovereign", "enterprise", "aidc-cn", "other"]},
    "notes": {"type": "string"},
    "disputed": {"type": "boolean", "default": false},
    "verified_date": {"type": "string", "description": "YYYY-MM-DD 最后人工核验日期"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["url", "grade"], "properties": {"url": {"type": "string"}, "grade": {"type": "string", "enum": ["regulatory", "company", "research", "media", "estimate"]}, "date": {"type": "string"}, "note": {"type": "string"}}}}
  }
}
