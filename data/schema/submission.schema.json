{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "成员投递单（一次投递 = 一个目录 + 一份 submission.json）",
  "description": "团队化的投递契约。设计前提：所有者是唯一的合并者，也就是唯一的瓶颈；所以机器必须在他看到之前挡掉不合格的投递。成员产**素材与结构化登记**，不产结论——Finding 由所有者与模型出（口径判断是新人最不可能会的部分，成员直接写 Finding 会以完全合理的方式悄悄污染知识层）。",
  "type": "object",
  "required": [
    "contributor",
    "submitted",
    "module",
    "items"
  ],
  "properties": {
    "contributor": {
      "type": "string",
      "description": "投递人标识，用于统计命中率——**成员 KPI 是命中率不是投递量**"
    },
    "submitted": {
      "type": "string",
      "description": "YYYY-MM-DD"
    },
    "module": {
      "type": "string",
      "pattern": "^M(0[1-9]|1[0-5])$",
      "description": "本次投递主要服务的模块"
    },
    "workorder": {
      "type": "string",
      "description": "当前任务集合中的 wid，来自 manage.py workorders 或研究任务界面。留空为自主发现；中分候选等待匹配，不自动降分。"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "title",
          "org",
          "year",
          "modules",
          "claimed_importance",
          "confidence",
          "summary"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "相对本投递目录的文件名"
          },
          "title": {
            "type": "string",
            "description": "材料原标题"
          },
          "org": {
            "type": "string",
            "description": "出品机构。**不确定就写「未署名」，不许猜**"
          },
          "year": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^M(0[1-9]|1[0-5])$"
            },
            "description": "命中的模块，可多个。宁可多标不要漏标——漏标会让那个模块的货架看着是空的"
          },
          "claimed_importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9,
            "description": "自评分。**这是「申报值」不是终值**，审阅时会被改判"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ],
            "description": "A 一手/实测/官方规范；B 机构预测/会议演示版；C 转述/汇编/方法论不明"
          },
          "summary": {
            "type": "string",
            "minLength": 200,
            "description": "至少 200 字，如实记录数字或非数字证据及适用条件，不将候选冒充已采用结论。"
          },
          "key_numbers": {
            "type": "array",
            "description": "候选数字及原文定位；非数字材料可用 key_statements，不能因没有数字判无贡献。",
            "items": {
              "type": "object",
              "required": [
                "what",
                "value",
                "unit",
                "locator"
              ],
              "properties": {
                "what": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "locator": {
                  "type": "string",
                  "description": "页码/表号/段落——**要能让人翻回去核对那一个数**，写不出就说明你没真看到它"
                },
                "caliber_note": {
                  "type": "string",
                  "description": "口径说明：这个数含什么不含什么、什么阶段、什么地域"
                }
              }
            }
          },
          "sensitive": {
            "type": "boolean",
            "default": false,
            "description": "含个人信息/业主商业信息/可能不宜对外，标了会强制走人工审阅"
          },
          "novel_angle": {
            "type": "string",
            "description": "新增研究角度的说明；不因填写自动加权。"
          },
          "replaces_record_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "拟改写的既有结论记录 ID；声明即进入 A 人审，不授予覆盖权。"
          },
          "key_statements": {
            "type": "array",
            "description": "可定位的非数字候选证据，与 key_numbers 同等有效。",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "text",
                "quote",
                "locator"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "definition",
                    "mechanism",
                    "interface",
                    "standard",
                    "failure_case"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
