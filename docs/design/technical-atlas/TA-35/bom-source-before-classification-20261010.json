{
  "source_commit": "81735cea408ed3a1d26d1bcfdaeec5391e296c44",
  "source_path": "web/pages/bom.html",
  "sha256": "de5d1182fbf2b1dc29a342f3023127e4935c025e6ee7211a3b5fc405838d6417",
  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\" data-ui-skin=\"folk\" data-ui-theme=\"light\" data-ui-mode=\"light\">\n<head>\n<script src=\"/assets/theme-state.js\"></script>\n<script src=\"/assets/site-skin.js\"></script>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>数据中心爆炸图 — inresearch.ai</title>\n<style>\n\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  body { background: var(--bg); color: var(--text); font: 13.5px/1.6 var(--ui-font); padding-bottom: 60px; }\n  a { color: var(--accent); text-decoration: none; }\n  .topbar { position: sticky; top: 0; background: var(--card); border-bottom: 1px solid var(--line);\n    display: flex; align-items: center; gap: 4px; padding: 0 18px; height: 46px; z-index: 20; }\n  .topbar b { font-size: 15px; margin-right: 14px; }\n  .tab { padding: 12px 14px; color: var(--muted); border-bottom: 2px solid transparent; }\n  .tab.on { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }\n  .topbar .sp { flex: 1; }\n  .wrap { max-width: 1360px; margin: 18px auto 0; padding: 0 16px; display: flex; gap: 16px; }\n  .stage { flex: 1; min-width: 0; }\n  .stage h1 { font-size: 26px; letter-spacing: .5px; }\n  .stage h1 em { font-style: normal; color: var(--accent); }\n  .sub { color: var(--muted); font-size: 12.5px; margin: 2px 0 10px; }\n  .legend { font-size: 11.5px; color: var(--muted); margin-bottom: 16px; display: flex; align-items: center; flex-wrap: wrap; gap: 2px; }\n  .legend i { display: inline-block; width: 10px; height: 10px; border-radius: var(--ui-radius); vertical-align: -1px; margin: 0 4px 0 12px; }\n  .modes { margin-left: 14px; display: inline-flex; gap: 4px; }\n  .mode { font: inherit; font-size: 11.5px; padding: 2px 10px; border: 1px solid var(--line); border-radius: var(--ui-radius); background: var(--card); color: var(--muted); cursor: pointer; }\n  .mode.on { color: var(--accent); border-color: var(--accent); font-weight: 600; }\n  .sysh { margin: 14px 0 6px; display: flex; align-items: baseline; gap: 10px; border-bottom: 1px solid var(--line); padding-bottom: 4px; }\n  .sysh b { font-size: 15px; } .sysh .en { color: var(--muted); font-size: 11.5px; }\n  .legend .go3d { margin-left: auto; font-size: 12px; border: 1px solid var(--accent); border-radius: var(--ui-radius); padding: 2px 12px; }\n\n  #stack { position:relative; }\n  .pchip { display:inline-flex; align-items:center; gap:6px; border:1px solid var(--line); padding:4px 10px; font:inherit; background:var(--bg); color:var(--text); cursor:pointer; }\n  .pchip i { width:7px; height:7px; border-radius:50%; }\n  .pchip.sel { border-color:var(--accent); }\n  .callout { padding:18px; background:var(--card); border:1px solid var(--line); }\n  .callout .cd { color:var(--muted); margin:6px 0 12px; }\n  .plist { display:flex; flex-wrap:wrap; gap:8px; }\n  aside { grid-column:1/-1; min-width:0; margin:0 0 18px; }\n  aside[hidden] { display:none; }\n  #selected-atlas { grid-column:1/-1; min-width:0; scroll-margin-top:calc(var(--ui-bar-height) + 66px); margin:0 0 18px; }\n  .atlas-context { padding:10px 0; color:var(--muted); }\n  .dossier { background: var(--card); border: 1px solid var(--line); border-radius: var(--ui-radius); padding: 18px; }\n  html[data-ui-skin] #detail-panel #dossier { position:relative; top:auto; max-height:none; }\n  #detail-panel .close { position:absolute; right:14px; top:14px; cursor:pointer; }\n  #detail-panel h2 { padding-right:32px; }\n  .dossier h2 { font-size: 17px; margin-bottom: 2px; }\n  .dossier .meta { font-size: 11.5px; color: var(--muted); margin-bottom: 10px; }\n  .badge { display: inline-block; font-size: 10.5px; font-weight: 600; padding: 1px 9px; border-radius: var(--ui-radius); color: #fff; }\n  .sec { margin-top: 14px; }\n  .sec h3 { font-size: 12px; color: var(--muted); font-weight: 500; margin-bottom: 6px; }\n  .chip { display: inline-block; border: 1px solid var(--line); border-radius: var(--ui-radius); padding: 2px 10px;\n    font-size: 11.5px; margin: 0 4px 6px 0; color: var(--text); }\n  .chip:hover { border-color: var(--accent); color: var(--accent); }\n  .kv { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px dashed var(--line); font-size: 12.5px; }\n  .kv:last-child { border-bottom: none; }\n  .kv b { font-variant-numeric: tabular-nums; }\n  .empty { color: var(--gray); font-size: 12px; }\n  /* Explicit system and scale category layouts reuse adopted equipment images. */\n  .system-index { display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 18px; }\n  .system-index a { border:1px solid var(--line); padding:5px 12px; background:var(--card); border-radius:var(--ui-radius); }\n  .system-section { scroll-margin-top:110px; margin-bottom:28px; }\n  .system-section .sysh { margin:0 0 12px; padding-bottom:8px; }\n  .system-section .sysh b { font-size:21px; color:var(--text); }\n  .system-subhead { font-size:16px; margin:18px 0 8px; }\n  .system-chain.lrow { display:block; margin:0 0 14px; padding:14px; border:1px solid var(--line); background:var(--card); border-radius:var(--ui-radius); }\n  .chain-heading { display:flex; flex-wrap:wrap; gap:7px; align-items:baseline; margin-bottom:8px; }\n  .chain-heading h3 { font-size:15px; font-weight:650; }\n  .chain-heading small { color:var(--muted); font-size:11px; }\n  .equipment-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(155px,1fr)); gap:10px; }\n  .equipment.pbox { display:flex; flex-direction:column; min-width:0; padding:0 0 9px; border:1px solid var(--line); border-radius:var(--ui-radius); overflow:hidden; text-align:left; background:var(--bg); color:var(--text); font:inherit; cursor:pointer; transition:border-color .15s; }\n  .equipment.pbox:hover { transform:none; border-color:var(--accent); }\n  .equipment.pbox.sel { border-color:var(--accent); box-shadow:0 0 0 1px var(--accent); }\n  .equipment img { display:block; width:100%; height:auto; aspect-ratio:3/2; object-fit:contain; background:#FAF9F2; }\n  .equipment b { font-size:12.5px; line-height:1.45; padding:7px 9px 3px; }\n  .equipment .part-status { font-size:10.5px; color:var(--muted); padding:0 9px; }\n  .equipment .part-status i { display:inline-block; width:6px; height:6px; border-radius:50%; margin-right:5px; }\n  .system-note { color:var(--muted); font-size:12px; margin:6px 0 10px; }\n  .system-software { border:1px solid var(--line); border-radius:var(--ui-radius); padding:14px; background:var(--card); }\n  #stack > .axis { display:none; }\n  .scale-section { scroll-margin-top:110px; margin-bottom:26px; }\n  .scale-section .sysh b { font-size:21px; }\n  .scale-row.lrow { display:block; padding:14px; border:1px solid var(--line); background:var(--card); border-radius:var(--ui-radius); }\n  .scale-summary { font-size:12px; color:var(--muted); margin:0 0 12px; }\n  #scale-overview-actions { margin:6px 0 18px; }\n  #scale-overview-actions[hidden],#system-overview-actions[hidden] { display:none; }\n  #stack #selected-atlas { padding:0 12px 10px; }\n  /* Overview first; the main document owns the full page width. */\n  .wrap { max-width:1600px; display:block; margin:28px auto 0; padding:0 32px; }\n  body { font-size:14px; }\n  .sub { font-size:14px; max-width:1000px; margin:8px 0 24px; }\n  .section-heading { display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; margin:0 0 16px; }\n  .section-heading h2 { font-size:22px; font-weight:600; }\n  .section-heading p,.overview-note { color:var(--muted); font-size:13px; }\n  .section-step { font-size:13px; color:var(--muted); border:1px solid var(--line); padding:2px 8px; }\n  #overview { padding:24px; border:1px solid var(--line); background:var(--card); margin-bottom:28px; }\n  .framework-map { display:grid; grid-template-columns:minmax(0,1fr) 70px minmax(0,1.3fr) 70px minmax(0,1fr); gap:12px 0; }\n  .map-node { display:block; min-width:0; padding:18px; border:1px solid var(--line); color:var(--text); background:var(--bg); }\n  a.map-node:hover { border-color:var(--accent); }\n  .map-node strong { font-size:18px; font-weight:600; }\n  .map-node small { float:right; font-size:13px; color:var(--muted); }\n  .map-node p { color:var(--muted); font-size:13px; margin-top:6px; }\n  .map-facility,.map-control { grid-column:1/-1; display:flex; gap:24px; align-items:center; }\n  .map-control { border-style:dashed; }\n  .map-control p,.map-facility p { margin:0; }\n  .map-flow { align-self:center; text-align:center; color:var(--muted); font-size:13px; }\n  .map-flow span { display:block; font-size:28px; line-height:1.2; color:var(--text); }\n  .map-it { border-color:var(--accent); }\n  .it-branches { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; margin:12px 0; }\n  .it-branches a { text-align:center; padding:5px; border:1px solid var(--line); color:var(--text); font-size:14px; }\n  .it-branches a:hover { border-color:var(--accent); }\n  .map-rights { grid-column:1/-1; display:flex; gap:12px; align-items:baseline; flex-wrap:wrap; padding-top:12px; border-top:1px solid var(--line); }\n  .map-rights span { color:var(--muted); font-size:13px; }\n  .overview-note { margin-top:14px; }\n  #scale-map { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:10px; }\n  #scale-map .map-node { padding:14px; }\n  #scale-map .map-node strong { font-size:16px; }\n  #scale-map .map-node small { float:none; display:block; margin-top:8px; }\n  #scale-map[hidden],.framework-map[hidden] { display:none; }\n  .legend { font-size:13px; gap:6px; margin:14px 0; }\n  .mode { font-size:14px; padding:5px 14px; }\n  .legend .go3d { font-size:13px; }\n  .system-index { position:sticky; top:calc(var(--ui-bar-height) + 50px); z-index:10; background:var(--bg); padding:10px 0; border-bottom:1px solid var(--line); margin:0 0 24px; }\n  .system-index a { font-size:14px; }\n  .system-section,.scale-section { scroll-margin-top:calc(var(--ui-bar-height) + 130px); margin-bottom:36px; }\n  .system-section .sysh { display:flex; flex-wrap:wrap; gap:8px 16px; }\n  .system-section .sysh b { font-size:22px; font-weight:600; }\n  .sysh .en { font-size:13px; }\n  .system-intro { font-size:14px; color:var(--muted); margin:0 0 16px; }\n  .chain-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; align-items:start; }\n  .system-chain.lrow { margin:0; padding:16px; }\n  .chain-heading { justify-content:space-between; gap:8px; margin-bottom:14px; }\n  .chain-heading h3 { font-size:16px; font-weight:600; }\n  .chain-heading small { font-size:13px; }\n  .system-subhead { margin:0 0 10px; scroll-margin-top:calc(var(--ui-bar-height) + 130px); }\n  .equipment-grid { grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; }\n  .equipment { max-width:280px; }\n  .equipment b { font-size:14px; font-weight:550; padding:10px 12px 5px; }\n  .equipment .part-status { font-size:13px; padding:0 12px; }\n  .system-note,.scale-summary { font-size:13px; }\n  .other-entries { display:block; margin:24px 0 0; scroll-margin-top:calc(var(--ui-bar-height) + 130px); }\n  .scale-row .equipment-grid { grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); }\n  @media(max-width:900px) {\n    .wrap { padding:0 18px; margin-top:20px; }\n    .framework-map { grid-template-columns:minmax(0,1fr) 44px minmax(0,1.2fr) 44px minmax(0,1fr); }\n    .map-node { padding:12px; }\n    .map-node small { float:none; display:block; }\n    .chain-grid { grid-template-columns:1fr; }\n    #scale-map { grid-template-columns:repeat(3,minmax(0,1fr)); }\n  }\n  @media(max-width:600px) {\n    .wrap { padding:0 12px; }\n    .stage h1 { font-size:24px; }\n    #overview { padding:14px; }\n    .section-heading h2 { font-size:19px; }\n    .framework-map { grid-template-columns:1fr; gap:10px; }\n    .map-facility,.map-control { grid-column:auto; display:block; }\n    .map-control p,.map-facility p { margin-top:6px; }\n    .map-rights { grid-column:auto; }\n    .map-flow { display:flex; gap:10px; align-items:center; justify-content:center; }\n    .map-flow span { transform:rotate(90deg); font-size:24px; }\n    #scale-map { grid-template-columns:repeat(2,minmax(0,1fr)); }\n    .legend .go3d { margin:8px 0; }\n    .modes { margin-left:0; }\n    .system-index { gap:6px; top:calc(var(--ui-bar-height) + 50px); }\n    .system-index a { padding:4px 9px; font-size:13px; }\n    .equipment-grid,.scale-row .equipment-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }\n    .system-chain.lrow,.scale-row.lrow { padding:10px; }\n    .equipment b { padding:8px 8px 4px; }\n    .equipment .part-status { padding:0 8px; }\n    aside { width:100%; }\n    aside .dossier { padding:14px; }\n  }\n  @media print { aside,.legend,.system-index { display:none; } .wrap { max-width:none; padding:0; } .chain-grid { display:block; } .system-chain { break-inside:avoid; } }\n\n</style>\n<link rel=\"preload\" as=\"font\" type=\"font/woff2\" crossorigin href=\"/assets/fonts/noto-sans-sc-1.woff2\"><link rel=\"stylesheet\" href=\"/assets/fonts/fonts.css\"><link rel=\"stylesheet\" href=\"/assets/site-skin.css\">\n</head>\n<body>\n<inresearch-shell data-section=\"bom\"></inresearch-shell>\n<div class=\"topbar\">\n  <a class=\"tab on\" href=\"bom.html\">爆炸图 2D</a>\n  <a class=\"tab\" href=\"bom3d.html\">爆炸图 3D</a>\n  <a class=\"tab\" href=\"rack3d.html\">机柜拆解台</a>\n  <a class=\"tab\" href=\"product-catalog.html\">规格库</a>\n  <span class=\"sp\"></span>\n</div>\n<div class=\"wrap\">\n  <div class=\"stage\">\n    <h1>一张图拆解 <em>AI 数据中心</em></h1>\n    <div class=\"sub\">先看五个系统怎样协作，再沿功能链路拆到设备与组件。点击总图定位系统，点击设备查看结构图与研究档案。</div>\n    <section id=\"overview\" aria-labelledby=\"overview-title\">\n      <div class=\"section-heading\"><span class=\"section-step\">01</span><h2 id=\"overview-title\">先看全局：系统怎样协作</h2><p>总图 → 系统 → 功能链段 → 设备与组件</p></div>\n      <div id=\"system-map\" class=\"framework-map\" aria-label=\"五系统运行关系总图\">正在加载系统总图…</div>\n      <div id=\"scale-map\" aria-label=\"五尺度构成总图\" hidden></div>\n      <p class=\"overview-note\" id=\"overview-note\">箭头表示供电与排热关系；设施提供空间与安全环境，控制与软件贯穿各系统。设备类别与替代方案在下方分别展开。</p>\n    </section>\n    <div class=\"section-heading\"><span class=\"section-step\">02</span><h2 id=\"breakdown-title\">再看拆解：系统与功能链路</h2><p>设备类别示例 · 点击查看部件档案</p></div>\n    <div class=\"legend\">供应状态：<i style=\"background:var(--red)\"></i>紧缺 <i style=\"background:var(--yellow)\"></i>技术切换中\n      <i style=\"background:var(--green)\"></i>成熟 <i style=\"background:var(--purple)\"></i>新兴\n      <span class=\"modes\"><button type=\"button\" class=\"mode on\" data-mode=\"system\">按系统</button><button type=\"button\" class=\"mode\" data-mode=\"scale\">按尺度</button></span>\n      <a class=\"mode\" href=\"/cross-scale-atlas.html\" data-atlas-cross-scale>跨尺度讲解图 →</a>\n      <a class=\"go3d\" href=\"bom3d.html\">🧊 进入 3D 立体拆解 →</a></div>\n    <p class=\"system-note\" id=\"system-overview-actions\"><a href=\"/assets/technical-atlas/system-overview-v2.svg\" target=\"_blank\" rel=\"noopener\">查看五系统总览示意 ↗</a> · <a href=\"/assets/technical-atlas/system-overview-v2.svg\" download=\"system-overview-v2.svg\">下载标注总览</a> · <a href=\"/assets/technical-atlas/system-overview-v2.png\" download=\"system-overview-v2.png\">下载无字总览</a><br>每个物理系统仅取一个代表；完整类别展开在下方。</p>\n    <p class=\"system-note\" id=\"scale-overview-actions\" hidden><a href=\"/assets/technical-atlas/scale-overview-v1.svg\" target=\"_blank\" rel=\"noopener\">查看五尺度总览示意 ↗</a> · <a href=\"/assets/technical-atlas/scale-overview-v1.svg\" download=\"scale-overview-v1.svg\">下载标注总览</a> · <a href=\"/assets/technical-atlas/scale-overview-v1.png\" download=\"scale-overview-v1.png\">下载无字总览</a><br>从部件到园区，每组取一代表；排版大小不表示实物比例。</p>\n    <div id=\"stack\">加载中…<div id=\"selected-atlas\" hidden></div></div>\n  </div>\n  <aside id=\"detail-panel\" aria-label=\"部件研究档案\" hidden><div class=\"dossier\" id=\"dossier\">\n    <h2>选择一个部件</h2>\n    <div class=\"meta\">点击部件图或词条查看档案——从电网到冷板，<span id=\"partCount\">61</span> 个部件各有档案。</div>\n  </div></aside>\n</div>\n\n<script type=\"module\">\nimport { createPartDossier } from \"./assets/part-dossier.js?v=20261008.15\";\nimport { atlasPreview, atlasPreviewTitle, atlasCategoryNote } from \"./assets/technical-atlas.js?v=20261010.17\";\nasync function get(p) {\n  const r = await fetch(p + \"?t=\" + Date.now(), { cache: \"no-store\" });\n  if (!r.ok) throw new Error(p + \" → \" + r.status);\n  return r.json();\n}\nconst SC = { tight: \"var(--red)\", transition: \"var(--yellow)\", mature: \"var(--green)\", emerging: \"var(--purple)\" };\nconst SN = { tight: \"紧缺\", transition: \"技术切换中\", mature: \"成熟\", emerging: \"新兴\" };\nconst esc = s => String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\");\nlet BOM, CN = {}, PRICES = [], INDS = {}, showDossier = null;\n\n(async () => {\n  const [bom, companies, prices, inds, rights] = await Promise.all([\n    get(\"framework/bom.json\"), get(\"data/companies.json\"), get(\"data/prices.json\"),\n    get(\"framework/indicators.json\"),\n    get(\"framework/site_rights.json\").catch(() => ({ rights: [] }))]);\n  BOM = bom; PRICES = prices.records;\n  const isPart = p => (p.kind || \"part\") === \"part\";\n  document.getElementById(\"partCount\").textContent = bom.parts.filter(isPart).length;\n  companies.records.forEach(c => CN[c.company_id] = c.name_cn || c.name);\n  inds.indicators.forEach(i => INDS[i.id] = i);\n  // 右栏是同一份部件档案（part-dossier.js，与 3D 共用）；2D 档案不启用 WebGL 预览\n  showDossier = createPartDossier({ el: document.getElementById(\"dossier\"), view: \"bom\", BOM: bom, companies: CN, prices, indicators: INDS,\n    statusNames: SN, statusColors: Object.fromEntries(Object.entries(SC).map(([k, v]) => [k, v])), inspector: { hide() {}, show() { return false; } },\n    atlasHost: document.getElementById('selected-atlas'), atlasViewFor: () => document.getElementById('stack').dataset.mode });\n\n  // 两种排法：按系统（第一层五个系统，IT 展开四个，系统内按链路）是骨架；按尺度（S5 → S1）是第二排法\n  const chips = parts => parts.map(p => `<button type=\"button\" class=\"pchip\" data-part=\"${p.id}\" id=\"c-${p.id}\"><i style=\"background:${SC[p.status]}\"></i>${esc(p.name)}</button>`).join(\"\");\n  const systemParts = sid => bom.parts.filter(p=>isPart(p) && (p.system===sid || bom.systems[p.system]?.parent===sid));\n  const systemTitle = sid => `${String(bom.systems[sid].order).padStart(2,'0')} ${esc(bom.systems[sid].name)}`;\n  function overviewNode(sid, description, cls='') {\n    return `<a class=\"map-node ${cls}\" href=\"#system-${sid}\" data-overview-system=\"${sid}\"><strong>${systemTitle(sid)}</strong><small>${systemParts(sid).length} 个设备类别</small><p>${description}</p></a>`;\n  }\n  const itBranches = Object.entries(bom.systems).filter(([,s])=>s.parent==='it').sort((a,b)=>a[1].order-b[1].order);\n  document.getElementById('system-map').innerHTML =\n    overviewNode('facility','提供建筑空间、机柜承载与消防安防','map-facility') +\n    overviewNode('power','电网接入 / 变电 / 发电与储能 / UPS / 配电 / 板级供电') +\n    '<div class=\"map-flow\">供电<span aria-hidden=\"true\">→</span></div>' +\n    `<div class=\"map-node map-it\"><a href=\"#system-it\" data-overview-system=\"it\"><strong>${systemTitle('it')}</strong></a><small>${systemParts('it').length} 个设备类别</small><div class=\"it-branches\">${itBranches.map(([id,s])=>`<a href=\"#it-${id}\">${esc(s.name.replace('IT · ',''))}</a>`).join('')}</div><p>计算处理任务；内存、存储与网络共同支撑。</p></div>` +\n    '<div class=\"map-flow\">热量<span aria-hidden=\"true\">→</span></div>' +\n    overviewNode('thermal','芯片与机柜集热 → 冷却回路 → 向环境排热') +\n    `<a class=\"map-node map-control\" href=\"#system-control\" data-overview-system=\"control\"><strong>${systemTitle('control')}</strong><p>DCIM / BMS 与固件 · 监测、管理和控制各系统</p></a>` +\n    `<div class=\"map-rights\"><a href=\"#site-rights\">建设前提：站点权利 ↘</a><span>${rights.rights.map(r=>esc(r.name)).join(' · ')}</span></div>`;\n  document.getElementById('scale-map').innerHTML = [...bom.scales].reverse().map(l=>`<a class=\"map-node\" href=\"#scale-${l.id}\"><strong>${esc(l.id)} ${esc(l.name)}</strong><p>${esc(l.desc)}</p><small>${bom.parts.filter(p=>isPart(p)&&p.scale===l.id).length} 个设备类别</small></a>`).join('');\n  function equipmentCard(p, view) {\n    return `<button type=\"button\" class=\"equipment pbox\" data-part=\"${p.id}\" data-atlas-part=\"${p.id}\" aria-label=\"查看 ${esc(p.name)} 档案\">\n      <img src=\"${atlasPreview(p.id,{view})}\" alt=\"${esc(atlasPreviewTitle(p.id,{view}))}\" width=\"1536\" height=\"1024\" loading=\"lazy\" decoding=\"async\">\n      <b id=\"c-${p.id}\">${esc(p.name)}</b><span class=\"part-status\"><i style=\"background:${SC[p.status]}\"></i>供应状态：${SN[p.status]}</span></button>`;\n  }\n  function byScale() {\n    const scales=[...bom.scales].reverse();\n    const nav=`<nav class=\"system-index scale-index\" aria-label=\"五尺度定位\">${scales.map(l=>`<a href=\"#scale-${l.id}\" data-scale-link=\"${l.id}\">${esc(l.id)} ${esc(l.name)}</a>`).join('')}</nav>`;\n    return nav+scales.map(layer=>{\n      const parts=bom.parts.filter(p=>isPart(p)&&p.scale===layer.id);\n      return `<section class=\"scale-section\" id=\"scale-${layer.id}\" data-scale=\"${layer.id}\"><div class=\"sysh\"><b>${esc(layer.id)} ${esc(layer.name)}</b><span class=\"en\">${esc(layer.en)}</span></div><p class=\"scale-summary\">${parts.length} 个物理类别 · ${esc(layer.desc)}。分组依据骨架登记，不表示图中设备的真实尺寸比例、项目数量或现场串联。</p><div class=\"scale-row lrow\" data-row-parts=\"${parts.map(p=>p.id).join(' ')}\"><div class=\"equipment-grid\">${parts.map(p=>equipmentCard(p,'scale')).join('')}</div></div></section>`;\n    }).join('');\n  }\n  function bySystem() {\n    const S=bom.systems;\n    const top=Object.entries(S).filter(([,s])=>!s.parent).sort((a,b)=>a[1].order-b[1].order);\n    let n=0;\n    const card=p=>equipmentCard(p,'system');\n    const nav=`<nav class=\"system-index\" aria-label=\"五系统定位\">${top.map(([id,s])=>`<a href=\"#system-${id}\" data-system-link=\"${id}\">${esc(s.name)}</a>`).join('')}</nav>`;\n    return nav+top.map(([sid,s])=>{\n      const children=Object.entries(S).filter(([,x])=>x.parent===sid).sort((a,b)=>a[1].order-b[1].order);\n      const groups=children.length?children:[[sid,s]];\n      let inner=`<div class=\"sysh\"><b>${systemTitle(sid)}</b><span class=\"en\">${children.length?'计算 · 内存 · 存储 · 网络':s.chains.map(esc).join(' · ')}</span></div><p class=\"system-intro\">${({facility:'先有承载设备的空间与安全环境。',power:'从电力接入到负载供电，按功能链段拆解；发电、储能与不同供电方案分别列示。',thermal:'设备产生的热量经冷却回路排向环境；下列类别按登记链段从设施端到芯片端展开。',it:'计算、内存、存储和网络是协作的四个子系统，分别展开。',control:'贯穿设施、电力、冷却与 IT 的监测、管理和固件控制。'})[sid]}</p><div class=\"chain-grid\">`;\n      for(const[lid,l]of groups){\n        const subheading=children.length?`<h2 class=\"system-subhead\" id=\"it-${lid}\" data-it-system=\"${lid}\">${esc(l.name)}</h2>`:\"\";\n        for(const chain of l.chains){\n          const parts=bom.parts.filter(p=>isPart(p)&&p.system===lid&&p.chain===chain).sort((a,b)=>a.chain_order-b.chain_order);\n          if(!parts.length){\n            const software=bom.parts.filter(p=>!isPart(p)&&p.system===lid&&p.chain===chain);\n            inner+=`<div class=\"system-software\" data-chain=\"${lid}:${esc(chain)}\"><h3>${esc(chain)}</h3><p class=\"system-note\">软件用于监测、管理与固件控制，不画成物理设备，不占零件尺度。</p>${chips(software)}</div>`;continue;\n          }\n          inner+=`<section class=\"system-chain lrow\" data-chain=\"${lid}:${esc(chain)}\" data-row-parts=\"${parts.map(p=>p.id).join(' ')}\">${subheading}<div class=\"chain-heading\"><h3>${++n}. ${esc(chain)}</h3><small>${parts.length} 个设备类别 · 按骨架登记顺序</small></div><div class=\"equipment-grid\">${parts.map(card).join('')}</div></section>`;\n        }\n      }\n      return `<section class=\"system-section\" id=\"system-${sid}\" data-system=\"${sid}\">${inner}</div></section>`;\n    }).join('');\n  }\n  const stack = document.getElementById(\"stack\");\n  const atlasHost = document.getElementById('selected-atlas');\n  const detailPanel = document.getElementById('detail-panel');\n  function render(mode) {\n    atlasHost.remove();\n    detailPanel.remove();\n    stack.dataset.mode=mode;\n    document.getElementById('system-map').hidden=mode!=='system';\n    document.getElementById('scale-map').hidden=mode!=='scale';\n    document.getElementById('overview-title').textContent=mode==='system'?'先看全局：系统怎样协作':'先看全局：从园区到组件';\n    document.getElementById('breakdown-title').textContent=mode==='system'?'再看拆解：系统与功能链路':'再看拆解：五个尺度的设备类别';\n    document.getElementById('overview-note').textContent=mode==='system'?'箭头表示供电与排热关系；设施提供空间与安全环境，控制与软件贯穿各系统。设备类别与替代方案在下方分别展开。':'尺度表示部件归属层级，排版大小不代表实物比例；替代方案并列展示，不表示现场串联。';\n    document.getElementById(\"system-overview-actions\").hidden=mode!==\"system\";\n    document.getElementById(\"scale-overview-actions\").hidden=mode!==\"scale\";\n    stack.innerHTML = (mode === \"scale\" ? byScale() : bySystem()) + otherEntries(bom, rights.rights || [], mode);\n    stack.querySelector('.lrow[data-row-parts~=\"ssd\"]').insertAdjacentElement('afterend', atlasHost);\n    atlasHost.insertAdjacentElement('afterend', detailPanel);\n    document.querySelectorAll('[data-mode]').forEach(b => {\n      b.classList.toggle('on', b.dataset.mode === mode);\n      b.setAttribute('aria-pressed', String(b.dataset.mode === mode));\n    });\n    document.querySelectorAll(\"[data-part]\").forEach(el => el.addEventListener(\"click\", () => show(el.dataset.part)));\n    history.replaceState(null, \"\", location.pathname + (mode === \"scale\" ? \"?view=scale\" : \"\") + location.hash);\n    const selected = resolveId(location.hash.slice(1));\n    show(selected);\n  }\n  document.querySelectorAll(\"[data-mode]\").forEach(b => b.addEventListener(\"click\", () => render(b.dataset.mode)));\n  render(new URLSearchParams(location.search).get(\"view\") === \"scale\" ? \"scale\" : \"system\");\n\n})().catch(e => document.getElementById(\"stack\").textContent = \"加载失败：\" + e.message);\n\n// 不占尺度的条目（软件、设施基型）与站点权利（framework/site_rights.json）：有价格、有主体，但不是零件\nfunction otherEntries(bom, rights, mode) {\n  const others = bom.parts.filter(p => (p.kind || \"part\") !== \"part\" && (mode !== \"system\" || p.system !== \"control\"));\n  const chips = others.map(p =>\n    `<button type=\"button\" class=\"pchip\" data-part=\"${p.id}\" id=\"c-${p.id}\"><i style=\"background:${SC[p.status]}\"></i>${esc(p.name)} <small>${esc(p.kind)}</small></button>`).join(\"\");\n  const rchips = rights.map(r =>\n    `<a class=\"pchip\" href=\"node.html?id=site:${r.id}\" title=\"${esc(r.desc || \"\")}\"><i style=\"background:${SC[r.status]}\"></i>${esc(r.name)}</a>`).join(\"\");\n  if (!chips && !rchips) return \"\";\n  return `<div class=\"lrow other-entries\" id=\"site-rights\">\n    <div class=\"callout\"><div class=\"ch\"><b>不占尺度的条目</b><span class=\"en\">Software · Archetype · Site rights</span></div>\n      <div class=\"cd\">软件与设施基型有订阅价与供应商但不是零件；站点权利（土地、水权、电力配额、燃气接入、网络接入、许可）不可采购，进目标表不进 3D。</div>\n      <div class=\"plist\">${chips}${rchips}</div></div></div>`;\n}\n// 旧部件 ID（重切前的 substation、fan-vc 等）经 bom.aliases 指向去处；指向权利的旧 ID 没有部件档案\nfunction resolveId(id) {\n  const a = BOM?.aliases?.[id];\n  if (!a) return id;\n  return a.startsWith(\"site:\") ? \"\" : a;\n}\n\nfunction clearSelection({clearHash = false} = {}) {\n  const host = document.getElementById('selected-atlas');\n  host.replaceChildren(); host.hidden = true;\n  document.getElementById('detail-panel').hidden = true;\n  document.querySelectorAll('.sel').forEach(el => el.classList.remove('sel'));\n  const dossier = document.getElementById('dossier');\n  const heading = document.createElement('h2'); heading.textContent = '选择一个部件';\n  const meta = document.createElement('div'); meta.className = 'meta';\n  const count = document.createElement('span'); count.id = 'partCount';\n  count.textContent = BOM?.parts.filter(p => (p.kind || 'part') === 'part').length ?? 61;\n  meta.append('点击设备图或名称查看档案——', count, ' 个物理类别各有档案。');\n  dossier.replaceChildren(heading, meta); dossier.style.display = clearHash ? 'none' : 'block'; delete dossier.dataset.partId;\n  if (clearHash) history.replaceState(null, '', location.pathname + location.search);\n}\n\nfunction show(pid) {\n  pid = resolveId(pid);\n  const p = BOM?.parts.find(x => x.id === pid);\n  if (!p) { clearSelection(); return; }\n  if (!showDossier) return;\n  document.querySelectorAll(\".pbox.sel, .pchip.sel, .equipment b.sel\").forEach(el => el.classList.remove(\"sel\"));\n  document.querySelectorAll(`[data-part=\"${pid}\"], #c-${pid}`).forEach(el => el.classList.add(\"sel\"));\n  history.replaceState(null, \"\", \"#\" + pid);\n  const illustrationNote = atlasCategoryNote(pid, {view: document.getElementById('stack').dataset.mode});\n  document.getElementById('detail-panel').hidden = false;\n  showDossier(illustrationNote ? {...p, desc: illustrationNote + ' 类别研究说明（不认证图中示例已适用）：' + (p.desc || '待补充')} : p);\n  const atlasHost = document.getElementById('selected-atlas');\n  if (atlasHost.hidden) {\n    const entry=document.querySelector(`[data-part=\"${pid}\"]`);\n    entry?.closest('.system-software, .other-entries')?.insertAdjacentElement('afterend', document.getElementById('detail-panel'));\n    document.getElementById('detail-panel').scrollIntoView({block:'nearest'});\n  }\n  if (!atlasHost.hidden) {\n    document.querySelector(`.lrow[data-row-parts~=\"${pid}\"]`)?.insertAdjacentElement('afterend', atlasHost);\n    atlasHost.insertAdjacentElement('afterend', document.getElementById('detail-panel'));\n    const context = document.createElement('p');\n    context.className = 'atlas-context';\n    const scale = BOM.scales.find(l=>l.id===p.scale);\n    const scaleContext = document.getElementById('stack').dataset.mode==='scale' && scale ? `${scale.id} ${scale.name} → ` : '';\n    context.textContent = `${scaleContext}${BOM.systems[p.system].name} → ${p.name}`;\n    atlasHost.prepend(context);\n    requestAnimationFrame(() => {\n      if (!atlasHost.hidden && location.hash === '#' + pid) atlasHost.scrollIntoView({block:'start'});\n    });\n  }\n}\ndocument.addEventListener('keydown', event => {\n  if (event.key !== 'Escape' || document.getElementById('detail-panel').hidden) return;\n  const selected = document.querySelector('.equipment.sel');\n  clearSelection({clearHash:true});\n  selected?.focus({preventScroll:true});\n});\nwindow.addEventListener('hashchange', () => show(location.hash.slice(1)));\ndocument.getElementById('dossier').addEventListener('click',event=>{\n  if(!event.target.closest('button[aria-label=\"关闭部件档案\"]'))return;\n  clearSelection({clearHash: true});\n});\n</script>\n</body>\n</html>\n",
  "scope": "TA35 historical link-only integration; current BOM classification supersedes its whole-page invariance on 2026-10-10"
}
